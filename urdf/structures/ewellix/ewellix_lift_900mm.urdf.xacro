<?xml version="1.0" ?>
<robot
  name="ewellix_lift_900mm"
  xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- EWELLIX LIFT -->
  <xacro:macro
    name="ewellix_lift_900mm"
    params="prefix parent cut_model:=false *origin">

    <!--
      Offset vertical para alinear:
      - malla del lift_link (visual/collision)
      - centro de masas del lift_link (inertial)
      - frame superior de montaje del brazo (ewellix_lift_top_link)

      Ajusta este valor (por ejemplo 0.9, 1.0, 1.05...) hasta que brazo + eje lineal queden bien.
    -->
    <xacro:property name="lift_z_offset" value="0.7"/>

    <!-- Lift base link (fixed part of the linear axis) -->
    <link name="${prefix}base_link">
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://robotnik_description/meshes/structures/ewellix/ewellix_lift_base_900mm.stl"
            scale="0.95 0.95 1" />
        </geometry>
        <material name="grey">
          <color rgba="0.7 0.7 0.7 1" />
        </material>
      </visual>

      <collision>
        <origin
          xyz="-0.005 0 0.00235"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://robotnik_description/meshes/structures/ewellix/ewellix_lift_base_900mm.stl"
            scale="0.95 0.95 1" />
        </geometry>
      </collision>

      <inertial>
        <mass value="20" />
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <inertia
          ixx="1e-1"
          ixy="0"
          ixz="0"
          iyy="1e-1"
          iyz="0"
          izz="1e-1" />
      </inertial>
    </link>

    <!-- Mount lift to parent robot link -->
    <joint
      name="${prefix}base_joint"
      type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}base_link" />
    </joint>

    <!-- Lift moving link (carriage / upper moving part) -->
    <link name="${prefix}link">
      <visual>
        <origin
          xyz="0 0 ${lift_z_offset}"
          rpy="0 0 0" />
        <geometry>
          <xacro:if value="${cut_model}">
            <mesh
              filename="package://robotnik_description/meshes/structures/ewellix/ewellix_lift_top_900mm_cut.stl" />
          </xacro:if>
          <xacro:unless value="${cut_model}">
            <mesh
              filename="package://robotnik_description/meshes/structures/ewellix/ewellix_lift_top_900mm_cut.stl" />
          </xacro:unless>
        </geometry>
        <material name="grey">
          <color rgba="0.7 0.7 0.7 1" />
        </material>
      </visual>

      <collision>
        <origin
          xyz="-0.005 0 ${0.00235 + lift_z_offset}"
          rpy="0 0 0" />
        <geometry>
          <xacro:if value="${cut_model}">
            <mesh
              filename="package://robotnik_description/meshes/structures/ewellix/ewellix_lift_top_900mm_cut.stl" />
          </xacro:if>
          <xacro:unless value="${cut_model}">
            <mesh
              filename="package://robotnik_description/meshes/structures/ewellix/ewellix_lift_top_900mm_cut.stl" />
          </xacro:unless>
        </geometry>
      </collision>

      <!-- Coherencia física con el desplazamiento visual/collision -->
      <inertial>
        <mass value="2" />
        <origin
          xyz="0 0 ${lift_z_offset}"
          rpy="0 0 0" />
        <inertia
          ixx="0.2e-1"
          ixy="0"
          ixz="0"
          iyy="0.2e-1"
          iyz="0"
          izz="0.2e-1" />
      </inertial>
    </link>

    <!-- Actuated prismatic joint (REAL linear axis joint) -->
    <joint
      name="${prefix}joint"
      type="prismatic">
      <parent link="${prefix}base_link" />
      <child link="${prefix}link" />
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <limit
        effort="1000"
        lower="0.0"
        upper="0.9"
        velocity="0.088" />
      <axis xyz="0 0 1" />
    </joint>

    <!-- Extra top mounting frame (3rd frame) for arm/payload attachment -->
    <link name="${prefix}ewellix_lift_top_link" />

    <!--
      Este frame es el que usa el brazo como parent.
      Si quieres que el brazo quede alineado con la geometría desplazada del lift_link,
      este origin debe llevar el mismo offset (lift_z_offset).
    -->
    <joint
      name="${prefix}ewellix_lift_top_joint"
      type="fixed">
      <parent link="${prefix}link" />
      <child link="${prefix}ewellix_lift_top_link" />
      <origin
        xyz="0 0 ${lift_z_offset}"
        rpy="0 0 0" />
    </joint>

    <gazebo reference="${prefix}base_link">
      <material>Gazebo/Grey</material>
    </gazebo>

    <gazebo reference="${prefix}link">
      <material>Gazebo/Grey</material>
    </gazebo>

    <!-- ros2_control MUST control the actuated prismatic joint -->
    <ros2_control
      name="${prefix}ewellix_lift_control"
      type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="${prefix}joint">
        <command_interface name="position" />
        <command_interface name="velocity" />
        <state_interface name="position">
          <!-- Replegado al iniciar -->
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
