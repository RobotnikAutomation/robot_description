<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rb1">



	<!-- Import differential base elements -->
	<xacro:include filename="$(find robotnik_description)/urdf/bodies/rb1/rb1_body.urdf.xacro" />

	<!-- Import wheels -->
	<xacro:include filename="$(find robotnik_description)/urdf/wheels/rubber_wheel/rubber_wheel_150.urdf.xacro" />

	<!-- Wheel parameters -->
	<xacro:property name="wheel_offset_x" value="0" />
	<xacro:property name="wheel_offset_y" value="0.218" />
	<xacro:property name="wheel_offset_z" value="0.0512" />

	<xacro:macro name="rb1" params="prefix:=robot_ hq:=true">

		<!-- *************** -->
		<!-- Robots Elements -->
		<!-- *************** -->

		<!-- Here we create the robot elements using the xacro:macros imported at the beggining of this file -->

		<!-- rb1 base -->
		<xacro:rb1_body prefix="${prefix}" hq="${hq}" />

		<!-- WHEELS -->
		<xacro:rubber_wheel prefix="${prefix}right_" parent="${prefix}base_link" hq="${hq}">
			<origin xyz="${wheel_offset_x} ${-wheel_offset_y} 0.0" rpy="0 0 0"/>
		</xacro:rubber_wheel>
		<xacro:rubber_wheel prefix="${prefix}left_" parent="${prefix}base_link" hq="${hq}">
			<origin xyz="${wheel_offset_x} ${wheel_offset_y} 0.0" rpy="0 0 0"/>
		</xacro:rubber_wheel>
	</xacro:macro>

</robot>
