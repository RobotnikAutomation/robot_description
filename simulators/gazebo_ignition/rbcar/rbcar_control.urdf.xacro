<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro
    name="rbcar_gz_ignition_control"
    params="namespace prefix">
    <gazebo>
      <plugin name="gz::sim::systems::PosePublisher" filename="libgz-sim-pose-publisher-system.so">
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
      </plugin>
      <plugin
        name="gz_ros2_control::GazeboSimROS2ControlPlugin"
        filename="gz_ros2_control-system">
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <parameters>$(find robotnik_description)/simulators/gazebo_ignition/rbcar/rbcar_controller_params.yaml</parameters>
        <ros>
          <namespace>/${namespace}</namespace>
        </ros>
      </plugin>
    </gazebo>

    <xacro:macro
      name="ros2_joint"
      params="interface jmin jmax name">
      <joint name="${name}">
        <command_interface name="${interface}">
          <param name="min">${jmin}</param>
          <param name="max">${jmax}</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
    </xacro:macro>

    <ros2_control
      name="GazeboSystem"
      type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      
      <!-- Front suspension shocks (effort control) -->
      <xacro:ros2_joint interface="effort" jmin="-100" jmax="100" name="${prefix}left_front_shock" />
      <xacro:ros2_joint interface="effort" jmin="-100" jmax="100" name="${prefix}right_front_shock" />
      
      <!-- Rear suspension shocks (effort control) -->
      <xacro:ros2_joint interface="effort" jmin="-100" jmax="100" name="${prefix}left_rear_shock" />
      <xacro:ros2_joint interface="effort" jmin="-100" jmax="100" name="${prefix}right_rear_shock" />
      
      <!-- Steering joints (position control) -->
      <xacro:ros2_joint interface="position" jmin="-0.785398163" jmax="0.785398163" name="${prefix}left_steering_joint" />
      <xacro:ros2_joint interface="position" jmin="-0.785398163" jmax="0.785398163" name="${prefix}right_steering_joint" />
      
      <!-- Front wheel axles (velocity control) -->
      <xacro:ros2_joint interface="velocity" jmin="-39.02" jmax="39.02" name="${prefix}left_front_axle" />
      <xacro:ros2_joint interface="velocity" jmin="-39.02" jmax="39.02" name="${prefix}right_front_axle" />
      
      <!-- Rear wheel axles (velocity control) -->
      <xacro:ros2_joint interface="velocity" jmin="-39.02" jmax="39.02" name="${prefix}left_rear_axle" />
      <xacro:ros2_joint interface="velocity" jmin="-39.02" jmax="39.02" name="${prefix}right_rear_axle" />
      
      <!-- Rear axle joint (effort control) -->
      <xacro:ros2_joint interface="effort" jmin="-600" jmax="600" name="${prefix}rear_axle_joint" />

    </ros2_control>
  </xacro:macro>
</robot>
