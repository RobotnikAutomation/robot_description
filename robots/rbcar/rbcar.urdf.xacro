<?xml version="1.0"?>
<robot
  name="rbcar"
  xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include
    filename="$(find robotnik_description)/urdf/bases/rbcar/rbcar_base.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_sensors)/urdf/all_sensors.urdf.xacro" />

<!-- ***************** -->
<!-- Global parameters -->
<!-- ***************** -->

<xacro:property name="PI" value="3.1415926535897931"/>

<!-- Flag to select the high or low quality model -->
<xacro:property name="hq" value="true" />
<xacro:arg name="gazebo_ignition" default="false"/>
<xacro:arg name="namespace" default="robot"/>
<xacro:arg name="prefix" default="robot_"/>
<xacro:arg name="gpu" default="true"/>

<!-- RB-CAR -->
<xacro:rbcar
    prefix="$(arg prefix)"
    gazebo_ignition="$(arg gazebo_ignition)"
    namespace="$(arg namespace)" />

<!-- Sensors-->
<!-- IMU -->
<xacro:sensor_vectornav
  frame_prefix="$(arg prefix)imu_"
  parent="$(arg prefix)base_link"
  node_namespace="$(arg namespace)"
  gazebo_ignition="$(arg gazebo_ignition)">
  <origin xyz="0.319 0.018 0.676" rpy="0 0 0"/>
</xacro:sensor_vectornav>

<!-- GPS -->
<xacro:sensor_ublox
  frame_prefix="$(arg prefix)gps_"
  parent="$(arg prefix)base_link"
  node_namespace="$(arg namespace)"
  node_name="gps"
  gazebo_ignition="$(arg gazebo_ignition)">
  <origin xyz="0.58 0 1.503" rpy="0 0 0"/>
</xacro:sensor_ublox>

<!-- 3D LiDAR -->
<xacro:sensor_rslidar_16
  frame_prefix="$(arg prefix)top_3d_laser_"
  parent="$(arg prefix)base_link"
  node_namespace="$(arg namespace)"
  node_name="top_lidar"
  gazebo_ignition="$(arg gazebo_ignition)"
  max_angle="3.14159"
  min_angle="-3.14159"
  gpu="$(arg gpu)">
  <origin xyz="1.40252 0.0 1.40341" rpy="0 0.288 0"/>
</xacro:sensor_rslidar_16>

<!-- Front 3D LiDAR -->
<xacro:sensor_rslidar_m1
  frame_prefix="$(arg prefix)front_laser_"
  parent="$(arg prefix)base_link"
  node_namespace="$(arg namespace)"
  node_name="front_lidar"
  gazebo_ignition="$(arg gazebo_ignition)"
  max_angle="1.0472"
  min_angle="-1.0472"
  gpu="$(arg gpu)">
  <origin xyz="2.28 0.0 0.30" rpy="0 3.015 3.14159"/>
</xacro:sensor_rslidar_m1>

<!-- Rear 2D LiDAR -->
<xacro:sensor_hokuyo_utm30lx
  frame_prefix="$(arg prefix)rear_laser_"
  parent="$(arg prefix)base_link"
  node_namespace="$(arg namespace)"
  node_name="rear_laser"
  gazebo_ignition="$(arg gazebo_ignition)"
  min_angle="-2.35"
  max_angle="2.35">
  <origin xyz="-0.4 0.0 0.20" rpy="0 0 3.14159"/>
</xacro:sensor_hokuyo_utm30lx>

<!--Gazebo plugins-->
<!-- <gazebo>
	<plugin name="ground_truth_controller" filename="librobotnik_gazebo_ground_truth_odom.so">
		<alwaysOn>true</alwaysOn>
		<updateRate>50.0</updateRate>
		<bodyName>$(arg prefix)base_link</bodyName>
		<frameName>base_footprint_gt</frameName>
		<worldBodyName>world</worldBodyName>
		<worldFrameName>$(arg prefix)odom</worldFrameName>
		<topicName>odom_gt</topicName>
		<gaussianNoise>0.01</gaussianNoise>
		<xyzOffset>0.0 0 0</xyzOffset>
		<rpyOffset>0 0 0</rpyOffset>
		<applyOffset>False</applyOffset>
		<broadcastTF>True</broadcastTF>
	</plugin>
</gazebo> -->

</robot>
