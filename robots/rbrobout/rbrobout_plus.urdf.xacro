<?xml version="1.0" ?>
<robot
  name="rbrobout"
  xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include
    filename="$(find robotnik_description)/urdf/bases/rbrobout/rbrobout_base.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_description)/urdf/bases/rbrobout/rbrobout_top_cover.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_description)/urdf/structures/ewellix/all_ewellix_lift.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_description)/urdf/arms/ur_macro.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_sensors)/urdf/all_sensors.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_sensors)/urdf/depth/intel_realsense_d435.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_sensors)/urdf/depth/intel_realsense_d435i.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_description)/urdf/grippers/suction_gripper/suction_gripper.urdf.xacro" />

  <!-- ARGUMENTS -->
  <xacro:arg name="namespace"      default="robot" />
  <xacro:arg name="prefix"         default="" />
  <xacro:arg name="gazebo_ignition" default="false" />
  <xacro:arg name="ur_type"        default="ur20" />
  <xacro:arg name="world_name" default="room_test_world"/>

  <!-- RB-ROBOUT BASE -->
  <xacro:rbrobout
    prefix="$(arg prefix)"
    gazebo_ignition="$(arg gazebo_ignition)"
    namespace="$(arg namespace)" />
  <xacro:top_cover
    prefix="$(arg prefix)"
    parent="$(arg prefix)base_link">
    <origin xyz="0 0 -0.1" rpy="0 0 0" />
  </xacro:top_cover>
  <xacro:ewellix_lift_900mm
    prefix="$(arg prefix)lift_"
    parent="$(arg prefix)base_link">
    <origin xyz="-0.76 0.0 0.18" rpy="0 0 0" />
  </xacro:ewellix_lift_900mm>

  <!-- ARM -->
  <xacro:arm_ur
    ur_type="$(arg ur_type)"
    frame_prefix="$(arg prefix)arm_"
    parent="$(arg prefix)lift_ewellix_lift_top_link"
    gazebo_ignition="$(arg gazebo_ignition)">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:arm_ur>

  <!-- WRIST CAMERA -->
  <xacro:sensor_intel_realsense_d435i
    frame_prefix="$(arg prefix)wrist_rgbd_camera_"
    parent="$(arg prefix)arm_tool0"
    node_namespace="$(arg namespace)"
    node_name="wrist_camera"
    gazebo_ignition="$(arg gazebo_ignition)">
    <origin xyz="0.0 -0.055 0.020" rpy="0 -1.5708 1.5708" />
  </xacro:sensor_intel_realsense_d435i>

  <!-- SUCTION GRIPPER -->
  <xacro:suction_gripper
    prefix="$(arg prefix)vacuum_"
    parent="$(arg prefix)arm_tool0"
    ns="$(arg namespace)">
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:suction_gripper>

  <!-- IMU -->
  <xacro:sensor_vectornav
    frame_prefix="$(arg prefix)imu_"
    parent="$(arg prefix)base_link"
    node_namespace="$(arg namespace)"
    gazebo_ignition="$(arg gazebo_ignition)">
    <origin xyz="0.3 -0.3 0.0725" rpy="0 0 0" />
  </xacro:sensor_vectornav>

  <!-- LASERS -->
  <xacro:sensor_sick_microscan3
    frame_prefix="$(arg prefix)front_laser_"
    parent="$(arg prefix)base_link"
    node_namespace="$(arg namespace)"
    node_name="front_laser"
    gazebo_ignition="$(arg gazebo_ignition)"
    max_angle="2.1"
    min_angle="-2.1">
    <origin xyz="0.8 0.366 -0.06" rpy="0 0 ${1/4*pi}" />
  </xacro:sensor_sick_microscan3>
  <xacro:sensor_sick_microscan3
    frame_prefix="$(arg prefix)rear_laser_"
    parent="$(arg prefix)base_link"
    node_namespace="$(arg namespace)"
    node_name="rear_laser"
    gazebo_ignition="$(arg gazebo_ignition)"
    max_angle="2.1"
    min_angle="-2.1">
    <origin xyz="-0.8 -0.366 -0.06" rpy="0 0 ${-3/4*pi}" />
  </xacro:sensor_sick_microscan3>

  <!-- FRONT CAMERA -->
  <xacro:sensor_intel_realsense_d435
    frame_prefix="$(arg prefix)front_rgbd_camera_"
    parent="$(arg prefix)base_link"
    node_namespace="$(arg namespace)"
    node_name="front_camera"
    gazebo_ignition="$(arg gazebo_ignition)">
    <origin xyz="0.835 0 0.1555" rpy="0 0 0" />
  </xacro:sensor_intel_realsense_d435>

  <!-- VACUUM GRIPPER PLUGIN -->
  <gazebo>
    <plugin filename="libVacuumGripper.so"
            name="vacuum_gripper_plugin::VacuumGripper">
      <suction_link>$(arg prefix)vacuum_link_suction_gripper</suction_link>
      <contact_topic>/world/$(arg world_name)/model/$(arg namespace)/link/$(arg prefix)vacuum_link_suction_gripper/sensor/$(arg prefix)vacuum_suction_contact_sensor/contact</contact_topic>
      <cmd_topic>/$(arg namespace)/vacuum_on</cmd_topic>
      <max_distance>0.15</max_distance>
    </plugin>
  </gazebo>

</robot>
