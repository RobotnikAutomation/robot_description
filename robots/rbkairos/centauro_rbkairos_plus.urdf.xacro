<?xml version="1.0" ?>
<robot
  name="rbkairos_plus"
  xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include
    filename="$(find robotnik_description)/urdf/bases/rbkairos/rbkairos_base.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_description)/urdf/arms/ur_macro.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_description)/urdf/structures/tools/onrobot_sander_zivid2.urdf.xacro" />
  <xacro:include
    filename="$(find robotnik_sensors)/urdf/all_sensors.urdf.xacro" />

  <!-- ARGUMENTS -->
  <xacro:arg
    name="namespace"
    default="robot" />
  <xacro:arg
    name="prefix"
    default="" />
  <xacro:arg
    name="gazebo_ignition"
    default="false" />
  <xacro:arg
    name="ur_type"
    default="ur10e" />

  <!-- RB-KAIROS -->
  <xacro:rbkairos
    prefix="$(arg prefix)"
    gazebo_ignition="$(arg gazebo_ignition)"
    namespace="$(arg namespace)" />

  <link name="$(arg prefix)top_column">
    <visual>
      <origin xyz="0.0 0.0 -0.150" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.300" radius="0.095"/>
      </geometry>
      <material name="grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 -0.150" rpy="0 0 0" />

      <geometry>
        <cylinder length="0.300" radius="0.095"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 -0.150" rpy="0 0 0" />
      <mass value="10.0"/>
       <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3"/>
    </inertial>
  </link>
  <joint name="$(arg prefix)top_column_joint" type="fixed">
    <origin xyz="0.0 0.0 0.300" rpy="0 0 0" />
    <parent link="$(arg prefix)top_cover"/>
    <child link="$(arg prefix)top_column" />
  </joint>

  <!-- ARMS -->
  <xacro:arm_ur
    ur_type="$(arg ur_type)"
    frame_prefix="$(arg prefix)arm_"
    parent="$(arg prefix)top_column"
    gazebo_ignition="$(arg gazebo_ignition)">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
  </xacro:arm_ur>

  <!-- TOOL -->
  <xacro:onrobot_sander_zivid2
    prefix="$(arg prefix)arm_tool_"
    parent="$(arg prefix)arm_tool0"
    node_namespace="$(arg namespace)"
    node_name="arm_tool_zivid2"
    gazebo_ignition="$(arg gazebo_ignition)"
    >
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
  </xacro:onrobot_sander_zivid2>

  <!-- IMU -->
  <xacro:sensor_vectornav
    frame_prefix="$(arg prefix)imu_"
    parent="$(arg prefix)base_link"
    node_namespace="$(arg namespace)"
    gazebo_ignition="$(arg gazebo_ignition)">
    <origin
      xyz="0.127 -0.129 0.212"
      rpy="0 0 0" />
  </xacro:sensor_vectornav>

  <!-- LASERS -->
  <xacro:sensor_sick_microscan3
    frame_prefix="$(arg prefix)front_laser_"
    parent="$(arg prefix)base_link"
    node_namespace="$(arg namespace)"
    node_name="front_laser"
    gazebo_ignition="$(arg gazebo_ignition)"
    max_angle="2.1"
    min_angle="-2.1">
    <origin
      xyz="0.42109 -0.32737 0.16037"
      rpy="0 ${-pi} ${3/4*pi}" />
  </xacro:sensor_sick_microscan3>
  <xacro:sensor_sick_microscan3
    frame_prefix="$(arg prefix)rear_laser_"
    parent="$(arg prefix)base_link"
    node_namespace="$(arg namespace)"
    node_name="rear_laser"
    gazebo_ignition="$(arg gazebo_ignition)"
    max_angle="2.1"
    min_angle="-2.1">
    <origin
      xyz="-0.42109 0.32737 0.16037"
      rpy="0 ${-pi} ${-1/4*pi}" />
  </xacro:sensor_sick_microscan3>

  <!-- CAMERAS -->
  <xacro:sensor_intel_realsense_d435
    frame_prefix="$(arg prefix)front_rgbd_camera_"
    parent="$(arg prefix)base_link"
    node_namespace="$(arg namespace)"
    node_name="front_camera"
    gazebo_ignition="$(arg gazebo_ignition)">
    <origin
      xyz="0.35850 0.0 0.25062"
      rpy="0 0 0" />
  </xacro:sensor_intel_realsense_d435>
</robot>
